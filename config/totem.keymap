#include <behaviors/num_word.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define Base        0
#define Num         1
#define SymL        2
#define SymR        3
#define Nav         4
#define Fun         5
#define SAI         6

&lt {
    quick-tap-ms = <100>;
    tapping-term-ms = <170>;
};

&mt {
    tapping-term-ms = <170>;
    flavor = "tap-preferred";
    quick-tap-ms = <100>;
};

&sk {
    quick-release;
    lazy;
};

/ {
    behaviors {
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_LEFT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <5 15 26 27 16 6 7 17 28 8 18 29 9 19 30 31 35 36 37 32 33 34>;
        };

        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_RIGHT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 21 22 23 24 25 32 33 20 34 35 36 37>;
        };

        hml_und: homerow_mods_left_undecided {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_LEFT_UNDECIDED";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <5 15 26 27 16 6 7 17 28 8 18 29 9 19 30 31 35 36 37 32 33 34>;
            hold-while-undecided;
        };

        mt_und: homerow_mods_undecided {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_UNDECIDED";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <100>;
            quick-tap-ms = <170>;
            flavor = "tap-preferred";
            hold-while-undecided;
        };

        unredo: morph_undo_redo {
            compatible = "zmk,behavior-mod-morph";
            label = "MORPH_UNDO_REDO";
            bindings = <&kp LC(Z)>, <&kp LC(Y)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        morph_excl: morph_exclamation_mark {
            compatible = "zmk,behavior-mod-morph";
            label = "MORPH_EXCLAMATION_MARK";
            bindings = <&kp EXCL>, <&kp RA(NUMBER_1)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        morph_qstn: morph_question_mark {
            compatible = "zmk,behavior-mod-morph";
            label = "MORPH_QUESTION_MARK";
            bindings = <&kp QUESTION>, <&kp RA(SLASH)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        lt_sk: layer_sticky_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_STICKY_TAP";
            bindings = <&mo>, <&sk>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <170>;
            quick-tap-ms = <100>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <16 17>;
            layers = <0>;
            require-prior-idle-ms = <150>;
        };

        combo_del_r {
            bindings = <&kp DELETE>;
            key-positions = <18 17>;
            layers = <0>;
            require-prior-idle-ms = <150>;
        };

        combo_esc {
            bindings = <&kp ESCAPE>;
            key-positions = <11 12>;
            layers = <0>;
            require-prior-idle-ms = <150>;
        };

        combo_del_l {
            bindings = <&kp DELETE>;
            key-positions = <12 13 11>;
            layers = <0>;
            require-prior-idle-ms = <150>;
        };

        combo_util_pscrn {
            bindings = <&kp PRINTSCREEN>;
            key-positions = <12 11>;
            layers = <1>;
            require-prior-idle-ms = <150>;
        };

        combo_util_mute {
            bindings = <&kp C_MUTE>;
            key-positions = <23 22>;
            layers = <1>;
            require-prior-idle-ms = <150>;
        };

        combo_nav_mute {
            bindings = <&kp C_MUTE>;
            key-positions = <28 29>;
            require-prior-idle-ms = <150>;
            layers = <2>;
        };

        combo_util_pause {
            bindings = <&kp C_PAUSE>;
            key-positions = <13 12>;
            layers = <1>;
            require-prior-idle-ms = <150>;
        };

        combo_nav_pause {
            bindings = <&kp C_PAUSE>;
            key-positions = <17 16>;
            require-prior-idle-ms = <150>;
            layers = <2>;
        };

        combo_return_r {
            bindings = <&kp RETURN>;
            key-positions = <16 17 18>;
            layers = <0 3>;
            require-prior-idle-ms = <150>;
        };

        combo_return_l {
            bindings = <&kp RETURN>;
            key-positions = <11 12 13>;
            layers = <1 3>;
        };

        combo_num_layer {
            bindings = <&ht_td_num 3 0>;
            key-positions = <12 13>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };

        combo_plus_r {
            bindings = <&kp PLUS>;
            key-positions = <16 17>;
            require-prior-idle-ms = <150>;
            layers = <3 1>;
        };

        combo_plus_l {
            bindings = <&kp PLUS>;
            key-positions = <12 13>;
            require-prior-idle-ms = <150>;
            layers = <3 1>;
        };

        combo_minus_l {
            bindings = <&kp MINUS>;
            key-positions = <11 12>;
            require-prior-idle-ms = <150>;
            layers = <3>;
        };

        combo_minus_r {
            bindings = <&kp MINUS>;
            key-positions = <17 18>;
            require-prior-idle-ms = <150>;
            layers = <3>;
        };
    };

    macros {
        space_num: space_num {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&mo 3 &kp SPACE>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo 3 &kp SPACE>;

            label = "SPACE_NUM";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            label = "Base";
            bindings = <
       &kp Q            &kp W            &kp E                    &kp R                  &kp T      &kp Y         &kp U                &kp I                &kp O            &kp P
       &hml LEFT_GUI A  &hml LEFT_ALT S  &hml_und LEFT_CONTROL D  &hml_und LEFT_SHIFT F  &kp G      &kp H         &hmr LEFT_SHIFT J    &hmr LEFT_CONTROL K  &hmr LEFT_ALT L  &hmr LEFT_GUI SINGLE_QUOTE
&none  &kp Z            &kp X            &kp C                    &kp V                  &kp B      &kp N         &kp M                &kp COMMA            &kp PERIOD       &kp MINUS                   &none
                                         &none                    &lt 1 SPACE            &kp TAB    &kp CAPSLOCK  &lt_sk 2 LEFT_SHIFT  &none
            >;
        };

        SymUtil {
            label = "SymUtil";
            bindings = <
       &kp END         &kp PAGE_UP        &kp PAGE_DOWN    &kp HOME    &none    &kp PIPE       &kp RIGHT_PARENTHESIS            &kp RIGHT_BRACKET              &kp RIGHT_BRACE           &kp SLASH
       &unredo         &kp LC(X)          &kp LC(C)        &kp LC(V)   &none    &kp BACKSLASH  &mt LEFT_SHIFT LEFT_PARENTHESIS  &mt LEFT_CONTROL LEFT_BRACKET  &mt RIGHT_ALT LEFT_BRACE  &kp ASTERISK
&none  &kp C_PREVIOUS  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_NEXT  &none    &kp RA(N)      &none                            &kp SEMICOLON                  &kp COLON                 &kp UNDERSCORE  &none
                                          &none            &none       &none    &none          &mo 4                            &none
            >;
        };

        SymNav {
            bindings = <
       &morph_qstn  &kp PERCENT       &kp CARET              &kp AMPERSAND          &none        &kp INSERT  &kp HOME        &kp PAGE_DOWN      &kp PAGE_UP      &kp END
       &morph_excl  &mt RIGHT_ALT AT  &mt LEFT_CONTROL HASH  &mt LEFT_SHIFT DOLLAR  &kp EQUAL    &tog 2      &kp LEFT_ARROW  &kp DOWN_ARROW     &kp UP_ARROW     &kp RIGHT_ARROW
&none  &none        &kp GRAVE         &kp TILDE              &none                  &none        &none       &kp C_PREVIOUS  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_NEXT       &none
                                      &none                  &mo 4                  &none        &none       &none           &none
            >;

            label = "SymNav";
        };

        Num {
            bindings = <
       &kp SLASH     &kp N7  &kp N8  &kp N9  &kp CARET       &kp CARET  &kp N7  &kp N8  &kp N9  &kp SLASH
       &kp ASTERISK  &kp N4  &kp N5  &kp N6  &kp DOT         &kp DOT    &kp N4  &kp N5  &kp N6  &kp ASTERISK
&none  &none         &kp N1  &kp N2  &kp N3  &none           &none      &kp N1  &kp N2  &kp N3  &none         &none
                             &none   &kp N0  &kp K_CANCEL    &kp EQUAL  &kp N0  &none
            >;

            label = "Num";
        };

        Fun {
            bindings = <
       &kp F12           &kp F7           &kp F8               &kp F9             &none             &none  &kp F7             &kp F8               &kp F9           &kp F12
       &mt LEFT_GUI F11  &mt LEFT_ALT F4  &mt LEFT_CONTROL F5  &mt LEFT_SHIFT F6  &studio_unlock    &none  &mt LEFT_SHIFT F4  &mt LEFT_CONTROL F5  &mt LEFT_ALT F6  &mt LEFT_GUI F11
&none  &kp F10           &kp F1           &kp F2               &kp F3             &none             &none  &kp F1             &kp F2               &kp F3           &kp F10           &none
                                          &none                &none              &none             &none  &none              &none
            >;

            label = "Fun";
        };

        SAI {
            bindings = <
       &trans  &trans              &trans                  &trans                &trans    &trans  &trans  &trans  &trans  &trans
       &trans  &mt_und LEFT_ALT S  &mt_und LEFT_CONTROL D  &mt_und LEFT_SHIFT F  &trans    &trans  &trans  &trans  &trans  &trans
&none  &trans  &trans              &trans                  &trans                &trans    &trans  &trans  &trans  &trans  &trans  &none
                                   &trans                  &space_num            &trans    &trans  &trans  &trans
            >;

            label = "SAI";
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
